# Committed defaults for this project. Arcane reads this file as the project
# env, so keep secrets out of it: every value here is public configuration.
# docker-compose.yml repeats these as ${VAR:-default}, so a missing key is safe.

# --- app ---------------------------------------------------------------
# Public port and bind address. Use 127.0.0.1 to keep the tool local-only.
APP_PORT=3390
APP_BIND=0.0.0.0
CONTAINER_NAME=speedtest
# Image tag built from ./app; worker containers reuse it.
SPEEDTEST_IMAGE=speedtest:local

# --- test workers ------------------------------------------------------
# auto   = docker when the socket answers, local child processes otherwise
# docker = require the socket (fails loudly if it is missing)
# native = always run workers as local processes (no container spawning)
WORKER_PROVIDER=auto
WORKER_COMMAND=node worker/server.mjs
WORKER_WORKDIR=/app
WORKER_NETWORK=speedtest-workers
WORKER_PORT=8080
WORKER_POOL_SIZE=3
WORKER_IDLE_SECONDS=120
WORKER_MAX_BYTES=536870912
# Shown in the page sidebar as "Test server".
WORKER_LOCATION=Local Docker Network
